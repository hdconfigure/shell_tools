copy_folder() {
    # Check that both source and destination arguments are provided
    if [ "$#" -lt 2 ]; then
        echo "Error: Missing arguments. Usage: copy_folder <source_dir> <target_dir>" >&2
        return 1
    fi

    # Strip any trailing slash from source path to ensure uniform POSIX behavior
    src="${1%/}"
    src="${src:-/}"
    dest="$2"

    # Verify the source exists and is a directory
    if [ ! -d "$src" ]; then
        echo "Error: Source '$1' does not exist or is not a directory." >&2
        return 1
    fi

    # Ensure the target directory exists (creates parent directories if needed)
    mkdir -p "$dest" || return 1

    # Recursive copy into the target directory
    cp -R "$src" "$dest/"
}
copy_folder "$@"
