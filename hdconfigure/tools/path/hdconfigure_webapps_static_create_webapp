#!/usr/bin/env sh
#~/.config/hdconfigure/tools/git/shell_tools/hdconfigure/tools/path_hdconfigure_webapps_static_create_webapp
#Copyright (C) 2026 by Theron Kauk and John Morris Beck <hdconfigure.direct@gmail.com> THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
tool_name="hdconfigure_webapps_static_create_webapp"

github_username="$1"
webapp_parent_directory="$HOME/.config/hdconfigure/webapps/static/$github_username"
github_repo_name="$2"
webapp_directory="$webapp_parent_directory/$github_repo_name"

if [ -d "$webapp_directory" ]; then
    error "error: $tool_name failed to create directory $webapp_directory. Webapp already exists at that directory."
    exit 1
fi

mkdir -p "$webapp_parent_directory" || { error "error: $tool_name failed to create directory $webapp_parent_directory."; exit 1; }
mkdir -p "$webapp_directory/assets" "$webapp_directory/home" || { error "error: $tool_name failed to create subdirectories in $webapp_directory."; exit 1; }

print 'Copyright (C) 2026 by Theron Kauk and John Morris Beck <hdconfigure.direct@gmail.com> THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.' > "$webapp_directory/license.txt" || { error "error: hdconfigure_webapps_static_create failed to create license file."; exit 1; }

print '<!-- Copyright (C) 2026 by Theron Kauk and John Morris Beck <hdconfigure.direct@gmail.com> THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE. -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="refresh" content="0; url=./home/">
    <title>Redirecting...</title>
    <script>
        window.location.replace("./home/");
    </script>
</head>
<body>
    <p>If you are not redirected automatically, <a href="./home/">click here</a>.</p><br><br>
Copyright (C) 2026 by Theron Kauk and John Morris Beck <hdconfigure.direct@gmail.com> THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.

</body>
</html>' > "$webapp_directory/index.html" || { error "error: $tool_name failed to create root index.html file for webapp."; exit 1; }

print 'node_modules/
dist/
.DS_Store
*~' > "$webapp_directory/.gitignore" || { error "error: $tool_name failed to create .gitignore file."; exit 1; }

git -C "$webapp_directory" init || { error "error: $tool_name failed to git init new webapp."; exit 1; }
git -C "$webapp_directory" branch -M main || { error "error: $tool_name failed to set new webapp to main branch."; exit 1; }
git -C "$webapp_directory" add . || { error "error: $tool_name failed to stage files in $webapp_directory."; exit 1; }
git -C "$webapp_directory" commit -m "Initial commit" || { error "error: $tool_name failed to perform initial commit."; exit 1; }
