tool_name="hdconfigure_webapps_static_create_webapp_publish"

github_username="$1"
github_repo_name="$2"
webapp_parent_directory="$HOME/.config/hdconfigure/webapps/static/$github_username"
webapp_directory="$webapp_parent_directory/$github_repo_name"

if [ ! -d "$webapp_directory" ]; then
    error "error: $tool_name failed. Webapp directory does not exist at $webapp_directory."
    exit 1
fi

if ! command -v gh >/dev/null 2>&1; then
    error "error: $tool_name failed. GitHub CLI (gh) is not installed or not in PATH."
    exit 1
fi

# Stage all current files (including new assets, subfolders, and code)
git -C "$webapp_directory" add . || {
    error "error: $tool_name failed to stage files in $webapp_directory."
    exit 1
}

# Commit changes if there are any uncommitted modifications
if ! git -C "$webapp_directory" diff-index --quiet HEAD -- 2>/dev/null; then
    git -C "$webapp_directory" commit -m "Publish webapp update" || {
        error "error: $tool_name failed to commit changes before publishing."
        exit 1
    }
fi

# Create the remote repo and push the committed history
gh repo create "$github_username/$github_repo_name" --public --source="$webapp_directory" --push || {
    error "error: $tool_name failed to create GitHub repository and push source files."
    exit 1
}

print "Success: $tool_name published $github_username/$github_repo_name to GitHub."
