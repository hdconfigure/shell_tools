tool_name="hdconfigure_webapps_build_directory"

github_username="$1"
github_repo_name="$2"
webapp_parent_directory="$HOME/.config/hdconfigure/webapps/static/$github_username"
webapp_directory="$webapp_parent_directory/$github_repo_name"

# Check if both arguments are present
if [ -z "$github_username" ] || [ -z "$github_repo_name" ]; then
    error "error: $tool_name requires both <github_username> and <github_repo_name> arguments."
    exit 1
fi

if [ ! -d "$webapp_directory" ]; then
    error "error: $tool_name failed to build directory. $webapp_directory is not a valid directory."
    exit 1
fi

# Find all directories and subdirectories and run the build page command on each
find "$webapp_directory" -type d -exec sh -c '
    for dir do
        hdconfigure_static_apps_build_page "$dir"
    done
' sh {} +
