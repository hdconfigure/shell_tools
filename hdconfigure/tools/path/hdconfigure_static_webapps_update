tool_name="hdconfigure_webapps_static_update"

github_username="$1"
github_repo_name="$2"
webapp_parent_directory="$HOME/.config/hdconfigure/webapps/static/$github_username"
webapp_directory="$webapp_parent_directory/$github_repo_name"

if [ ! -d "$webapp_directory" ]; then
    error "error: $tool_name failed. Webapp directory does not exist at $webapp_directory."
    exit 1
fi

# Stage all current files (respecting .gitignore)
git -C "$webapp_directory" add . || {
    error "error: $tool_name failed to stage files in $webapp_directory."
    exit 1
}

# Commit changes if there are any uncommitted modifications
if ! git -C "$webapp_directory" diff-index --quiet HEAD -- 2>/dev/null; then
    git -C "$webapp_directory" commit -m "Update webapp files" || {
        error "error: $tool_name failed to commit local changes."
        exit 1
    }
fi

# Ensure remote origin is set correctly
if ! git -C "$webapp_directory" remote get-url origin >/dev/null 2>&1; then
    git -C "$webapp_directory" remote add origin "https://github.com/$github_username/$github_repo_name.git" || {
        error "error: $tool_name failed to add git remote origin."
        exit 1
    }
fi

# Push updates to the main branch
git -C "$webapp_directory" push origin main || {
    error "error: $tool_name failed to push updates to GitHub main branch."
    exit 1
}

print "Success: $tool_name pushed local files for $github_username/$github_repo_name to main."
