tool_name="hdconfigure_webapps_static_publish_webapp"

github_username="$1"
github_repo_name="$2"
webapp_parent_directory="$HOME/.config/hdconfigure/webapps/static/$github_username"
webapp_directory="$webapp_parent_directory/$github_repo_name"

if [ ! -d "$webapp_directory" ]; then
    error "error: $tool_name failed. Webapp directory does not exist at $webapp_directory."
    exit 1
fi

if ! command -v gh >/dev/null 2>&1; then
    error "error: $tool_name failed. GitHub CLI (gh) is not installed or not in PATH."
    exit 1
fi

gh repo create "$github_username/$github_repo_name" --public --source="$webapp_directory" --push || {
    error "error: $tool_name failed to create GitHub repository and push source files."
    exit 1
}
