tool_name="hdconfigure_webapps_static_build_page"

if [ -z "$1" ]; then
    error "error: $tool_name usage: $tool_name <directory>"
    exit 1
fi

if [ ! -d "$1" ]; then
    error "error: $tool_name failed: '$1' is not a valid directory."
    exit 1
fi

# Check if index.ts exists before running the Node/tsx build
if [ -f "$1/index.ts" ]; then
    # Run the TypeScript file directly using Node.js experimental TypeScript loader or tsx/node
    node --import tsx "$1/index.ts" > "$1/index.html"
fi
